# Build context for deploy/docker/web.Dockerfile (context = web/).
# Everything the image needs is produced inside the image: `npm ci` installs Linux
# node_modules, `npm run gen:api` regenerates src/api/generated, `npm run build`
# produces dist/. Anything host-built that rides along is either dead weight or wrong
# for the target platform, so it is excluded here.

# --- dependencies: host (macOS/arm64) binaries must never reach the Linux image ---
node_modules
**/node_modules

# --- build output / caches (regenerated by `npm run build`) ---
dist
dist-ssr
coverage
*.tsbuildinfo
.vite
.eslintcache

# --- generated sources (regenerated by `npm run gen:api` / `gen:tokens`) ---
src/api/generated/*
!src/api/generated/README.md

# --- local environment: never bake a developer's .env into a published bundle ---
.env
.env.*
!.env.example

# --- vcs / editors / OS ---
.git
.gitignore
.dockerignore
.idea
.vscode
.DS_Store
*.swp

# --- logs ---
*.log
npm-debug.log*

# --- docs: not needed at build time ---
README.md
