# --- API ---
# Boş qoyulduqda sorğular eyni origin-ə (`/api/v1/...`) gedir və dev/preview serveri (yaxud
# production-da nginx) onları gateway-ə yönləndirir. Gateway CORS başlıqları göndərmədiyi üçün
# **tövsiyə olunan** konfiqurasiya budur.
VITE_API_BASE_URL=

# Proxy-nin hədəfi. docs/CONVENTIONS.md: standart port 5000, bu maşında 5001.
VITE_API_PROXY_TARGET=http://localhost:5001

# Gateway birbaşa çağırılacaqsa (CORS açıq olduqda) yuxarıdakını boş qoymaq əvəzinə bunu yazın:
# VITE_API_BASE_URL=http://localhost:5001

# --- Keycloak ---
# Realm `wms`. docs/CONVENTIONS.md: standart port 8080, bu maşında 8180.
VITE_KEYCLOAK_ISSUER=http://localhost:8180/realms/wms

# Public client, Authorization Code + PKCE (ADR-009).
VITE_KEYCLOAK_CLIENT_ID=wms-web
