{
  "// ReverseProxy note": "Cluster ids MUST stay valid POSIX shell identifiers (letters, digits, _). The container entrypoint is a /bin/sh script and dash drops environment variables whose names are not valid identifiers, so a cluster id with a '-' could never be overridden via ReverseProxy__Clusters__<id>__Destinations__d1__Address. See deploy/docker/backend.Dockerfile.",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" }
      },
      "masterdata": {
        "ClusterId": "masterdata",
        "Match": { "Path": "/api/v1/masterdata/{**catch-all}" }
      },
      "documents": {
        "ClusterId": "masterdata",
        "Match": { "Path": "/api/v1/documents/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/inventory/{**catch-all}" }
      },
      "consumption": {
        "ClusterId": "consumption",
        "Match": { "Path": "/api/v1/consumption/{**catch-all}" }
      },
      "procurement": {
        "ClusterId": "procurement",
        "Match": { "Path": "/api/v1/procurement/{**catch-all}" }
      },
      "reporting": {
        "ClusterId": "reporting",
        "Match": { "Path": "/api/v1/reporting/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "worker",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "integration": {
        "ClusterId": "worker",
        "Match": { "Path": "/api/v1/integration/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://wms-identity:8080/" } }
      },
      "masterdata": {
        "Destinations": { "d1": { "Address": "http://wms-masterdata:8080/" } }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://wms-inventory:8080/" } }
      },
      "consumption": {
        "Destinations": { "d1": { "Address": "http://wms-inventory:8080/" } }
      },
      "procurement": {
        "Destinations": { "d1": { "Address": "http://wms-procurement:8080/" } }
      },
      "reporting": {
        "Destinations": { "d1": { "Address": "http://wms-reporting:8080/" } }
      },
      "worker": {
        "Destinations": { "d1": { "Address": "http://wms-worker:8080/" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
