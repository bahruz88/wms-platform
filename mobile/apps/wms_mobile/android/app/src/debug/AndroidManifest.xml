<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!--
      Debug-only overrides. Gradle merges `src/debug` into debug builds and never into a release, so
      nothing here can reach a shipped APK.

      The dev stack is plain HTTP — the gateway on :5001 and Keycloak on :8180 — and Android has
      blocked cleartext by default since API 28. Without this the app starts and every call fails
      with a transport error that looks like the server being down.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />

</manifest>
