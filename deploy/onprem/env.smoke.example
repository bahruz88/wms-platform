# =============================================================================
# deploy/onprem/env.smoke.example
#
# Env file for a SMOKE TEST of the on-prem profile on a workstation that is already
# running the dev stack (`scripts/dev-up.sh`). It exists because both compose files
# read deploy/.env by default and would then fight over the same host ports.
#
#   cp deploy/onprem/env.smoke.example deploy/onprem/.env.smoke
#   cd deploy
#   ./onprem/render-realm.sh --env-file ./onprem/.env.smoke
#   docker compose --env-file ./onprem/.env.smoke -f docker-compose.onprem.yml up -d --build
#   docker compose --env-file ./onprem/.env.smoke -f docker-compose.onprem.yml \
#       --profile migrate run --rm migrator
#   ../scripts/db-ledger-grants.sh -f docker-compose.onprem.yml --env-file ./onprem/.env.smoke
#   ...
#   docker compose --env-file ./onprem/.env.smoke -f docker-compose.onprem.yml down -v
#
# The compose project is `wms-onprem` (docker-compose.onprem.yml `name:`), so containers,
# networks and volumes never collide with the dev project `wms` - only host ports do,
# which is what the offsets below fix.
#
# THIS IS NOT A PRODUCTION FILE. A real install copies .env.example to deploy/.env and
# replaces every password; see deploy/README.md §3.
# =============================================================================

# ---- images ----------------------------------------------------------------
# `onprem` keeps the smoke-test images apart from the dev stack's `:dev` tags.
IMAGE_PREFIX=wms
IMAGE_TAG=onprem
KEYCLOAK_VERSION=26.7

# ---- host ports: dev stack + 100 (and MySQL + 100 on top of the local 3308) ----
API_PORT=5100                 # dev gateway 5001
WEB_PORT=3100                 # dev web 3000/3002
MYSQL_PORT=3408               # dev MySQL 3308
KEYCLOAK_PORT=8280            # dev Keycloak 8180
RABBITMQ_MGMT_PORT=15772      # dev RabbitMQ UI 15672
MINIO_CONSOLE_PORT=9101       # dev MinIO console 9001

# ---- public URLs (what a browser types) --------------------------------------
KEYCLOAK_HOSTNAME=http://localhost:8280
WEB_PUBLIC_URL=http://localhost:3100
KEYCLOAK_REALM_FILE=./onprem/realm-wms.rendered.json

# ---- credentials: throwaway smoke-test values, NOT production ----------------
MYSQL_ROOT_PASSWORD=smoke_root_pw
MYSQL_APP_PASSWORD=smoke_app_pw
MYSQL_MIGRATOR_PASSWORD=smoke_migrator_pw
MYSQL_REPORTING_PASSWORD=smoke_reporting_pw
KEYCLOAK_DB_PASSWORD=smoke_keycloak_pw
REDIS_PASSWORD=smoke_redis_pw
RABBITMQ_USER=wms
RABBITMQ_PASSWORD=smoke_rabbit_pw
MINIO_ROOT_USER=smokeminio
MINIO_ROOT_PASSWORD=smoke_minio_pw
MINIO_BUCKET=wms-attachments
MINIO_PUBLIC_ENDPOINT=localhost:9100
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=smoke_admin_pw
KEYCLOAK_LOG_LEVEL=info
INTERNAL_API_KEY=smoke-internal-shared-secret
ANTIVIRUS_ENABLED=false

# Backups written by deploy/onprem/backup.sh (default /var/backups/wms needs root on macOS).
WMS_BACKUP_DIR=./onprem/backups
