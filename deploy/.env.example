# =============================================================================
# deploy/.env  - copy this file to `.env` (git-ignored) and adjust.
# Both docker-compose.yml (dev) and docker-compose.onprem.yml read it.
# Defaults = docs/CONVENTIONS.md. Change a value here instead of editing YAML.
# =============================================================================

# ---- images ----------------------------------------------------------------
IMAGE_PREFIX=wms
IMAGE_TAG=dev
KEYCLOAK_VERSION=26.7
SEQ_VERSION=2026.1

# ---- host ports (dev) --------------------------------------------------------
# macOS note: 5000 is taken by AirPlay Receiver (ControlCenter), 8080 is often used by
# other containers and 3306 by a local MySQL (XAMPP/Homebrew) -> override e.g.
# GATEWAY_PORT=5001, KEYCLOAK_PORT=8180, MYSQL_PORT=3308 and keep API_BASE_URL /
# KEYCLOAK_ISSUER below in sync. scripts/dev-up.sh reports conflicts before starting.
GATEWAY_PORT=5000
IDENTITY_PORT=5081
MASTERDATA_PORT=5082
INVENTORY_PORT=5083
PROCUREMENT_PORT=5084
REPORTING_PORT=5085
WORKER_PORT=5086
WEB_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080
SEQ_PORT=5341

# ---- what the browser / mobile app talks to (baked into the React web build as VITE_*) ----
API_BASE_URL=http://localhost:5000
KEYCLOAK_ISSUER=http://localhost:8080/realms/wms

# ---- credentials (dev defaults; MUST be changed for on-prem) -----------------
ASPNETCORE_ENVIRONMENT=Development
MYSQL_ROOT_PASSWORD=wms_root
MYSQL_APP_PASSWORD=wms_app
MYSQL_MIGRATOR_PASSWORD=wms_migrator
MYSQL_REPORTING_PASSWORD=wms_reporting
RABBITMQ_USER=wms
RABBITMQ_PASSWORD=wms
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wms-attachments
# MinIO address the BROWSER uses; presigned upload/download URLs are signed for this host.
MINIO_PUBLIC_ENDPOINT=localhost:9000
# ClamAV for attachment uploads (spec §11). Off in dev (no clamd container); with it on an unreachable
# clamd fails the upload closed rather than storing an unscanned file.
ANTIVIRUS_ENABLED=false
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=30
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_LOG_LEVEL=info
# Shared secret every backend container presents on the module-to-module /internal/* routes
# (backend/README.md §8.15). Same value in every container; generate a fresh one for any real
# deployment, e.g. `openssl rand -hex 32`.
INTERNAL_API_KEY=dev-internal-shared-secret

# ---- on-prem only (docker-compose.onprem.yml) --------------------------------
# Public URL of Keycloak as seen by browsers/mobiles (full URL, no trailing slash).
# Behind a TLS reverse proxy: https://auth.example.com ; plain LAN: http://192.168.1.10:8080
KEYCLOAK_HOSTNAME=http://localhost:8080
# Public URL of the web app (used for Keycloak redirect URIs by deploy/onprem/render-realm.sh)
WEB_PUBLIC_URL=http://localhost:3000
# Realm file to import (default: dev realm; on-prem: run deploy/onprem/render-realm.sh first)
KEYCLOAK_REALM_FILE=./keycloak/realm-wms.json
KEYCLOAK_DB_PASSWORD=change_me_keycloak
REDIS_PASSWORD=change_me_redis
API_PORT=5000
