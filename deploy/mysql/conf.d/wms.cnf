# WMS MySQL 8.4 LTS server settings (mounted at /etc/mysql/conf.d/wms.cnf).
# SPEC §6.4: utf8mb4 / utf8mb4_0900_ai_ci. SPEC §18.4: binlog (ROW) for point-in-time recovery.
[mysqld]
# --- charset / collation (SPEC §6.4) ---
character-set-server            = utf8mb4
collation-server                = utf8mb4_0900_ai_ci

# --- time: everything is stored and compared in UTC; the app converts for display ---
default-time-zone               = '+00:00'

# --- strict SQL mode: no silent truncation, no zero dates, no implicit engine substitution ---
sql_mode                        = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY

# --- InnoDB (modest defaults for a dev laptop / small on-prem box; raise on real servers) ---
innodb_buffer_pool_size         = 512M
innodb_log_buffer_size          = 32M
innodb_redo_log_capacity        = 512M
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = ON

# --- binary log: point-in-time recovery (SPEC §18.4, RPO <= 15 min) ---
server_id                       = 1
log_bin                         = binlog
binlog_format                   = ROW
binlog_row_image                = FULL
binlog_expire_logs_seconds      = 604800
sync_binlog                     = 1
gtid_mode                       = ON
enforce_gtid_consistency        = ON

# --- connections / misc ---
max_connections                 = 300
max_allowed_packet              = 64M
skip-name-resolve               = ON
log_error_verbosity             = 2
slow_query_log                  = ON
long_query_time                 = 2

[client]
default-character-set           = utf8mb4
